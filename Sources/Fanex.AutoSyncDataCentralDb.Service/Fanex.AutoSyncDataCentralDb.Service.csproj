<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- ReSharper disable once VulnerablePackage -->
    <PackageReference Include="Fanex.Caching.Redis" Version="2.2.8" />
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.3.4" />
    <PackageReference Include="Fanex.Logging.Extensions.Database" Version="2.0.2.1" />
    <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="2.0.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.DEV.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.LOCAL.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.PROD.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
<Content Include="appsettings.KLPROD.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.SIT.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="App_Data\SpName.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Remove="appsettings.DEV.json" />
    <None Remove="appsettings.json" />
    <None Remove="appsettings.LOCAL.json" />
    <None Remove="appsettings.PROD.json" />
<None Remove="appsettings.KLPROD.json" />
    <None Remove="appsettings.SIT.json" />
    <None Remove="App_Data\SpName.xml" />
    <None Remove="auto-league-settings.ini" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AutoSyncData\AutoSyncData.csproj" />
  </ItemGroup>
</Project>